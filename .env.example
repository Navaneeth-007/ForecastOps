# MLflow tracking server
# Use local file store by default (no server needed to start)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Optional: point to a hosted MLflow server
# MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: Postgres instead of SQLite for MLflow backend
# MLFLOW_TRACKING_URI=postgresql://user:pass@localhost:5432/mlflow

# API settings
API_URL=http://localhost:8000

# Scheduler — retraining cron (day_of_week, hour UTC)
RETRAIN_DAY=sun
RETRAIN_HOUR=2
